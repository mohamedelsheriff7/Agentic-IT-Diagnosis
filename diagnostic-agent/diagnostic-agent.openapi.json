{
  "openapi": "3.0.3",
  "info": {
    "title": "IT Diagnostic Agent API",
    "description": "Stateful diagnosis, targeted questions, evidence and confirmed resolution. Local mode performs no backend actions.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://shelf-roman-swimmable.ngrok-free.dev"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "agent_health",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/investigations": {
      "post": {
        "summary": "Start",
        "operationId": "start_diagnostic_investigation",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Start"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Start Diagnostic Investigation"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ]
      }
    },
    "/investigations/{ticket_id}/answers": {
      "post": {
        "summary": "Answer",
        "operationId": "answer_diagnostic_question",
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "parameters": [
          {
            "name": "ticket_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,100}$",
              "title": "Ticket Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Answer"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Answer Diagnostic Question"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/investigations/{ticket_id}": {
      "get": {
        "summary": "Trace",
        "operationId": "get_diagnostic_trace",
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "parameters": [
          {
            "name": "ticket_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,100}$",
              "title": "Ticket Id"
            }
          },
          {
            "name": "mode",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "local",
                "backend"
              ],
              "type": "string",
              "default": "local",
              "title": "Mode"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Get Diagnostic Trace"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/investigations/{ticket_id}/resolution": {
      "post": {
        "summary": "Resolution",
        "operationId": "confirm_diagnostic_resolution",
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "parameters": [
          {
            "name": "ticket_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,100}$",
              "title": "Ticket Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Confirm"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Confirm Diagnostic Resolution"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/langgraph/chat": {
      "post": {
        "summary": "Graph Chat",
        "description": "Local test host for the same factory that WXO imports natively.",
        "operationId": "chat_with_langgraph_agent",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GraphChat"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Chat With Langgraph Agent"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "Answer": {
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "local",
              "backend"
            ],
            "title": "Mode",
            "default": "local"
          },
          "answer": {
            "type": "string",
            "maxLength": 16000,
            "minLength": 1,
            "title": "Answer"
          },
          "evidence_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,100}$",
            "title": "Evidence Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "answer",
          "evidence_id"
        ],
        "title": "Answer"
      },
      "Confirm": {
        "properties": {
          "confirmed_by_user": {
            "type": "boolean",
            "title": "Confirmed By User"
          },
          "completed_step_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Completed Step Ids"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "confirmed_by_user"
        ],
        "title": "Confirm"
      },
      "GraphChat": {
        "properties": {
          "session_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,100}$",
            "title": "Session Id"
          },
          "message": {
            "type": "string",
            "maxLength": 32000,
            "minLength": 1,
            "title": "Message"
          },
          "mode": {
            "type": "string",
            "enum": [
              "local",
              "backend"
            ],
            "title": "Mode",
            "default": "local"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "session_id",
          "message"
        ],
        "title": "GraphChat"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LocalTicket": {
        "properties": {
          "ticket_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,100}$",
            "title": "Ticket Id"
          },
          "summary": {
            "type": "string",
            "maxLength": 250,
            "minLength": 1,
            "title": "Summary"
          },
          "description": {
            "type": "string",
            "maxLength": 16000,
            "minLength": 1,
            "title": "Description"
          },
          "priority": {
            "type": "string",
            "title": "Priority",
            "default": "3"
          },
          "language": {
            "title": "Language",
            "type": "string",
            "nullable": true
          },
          "security_sensitive": {
            "type": "boolean",
            "title": "Security Sensitive",
            "default": false
          },
          "privileged_access": {
            "type": "boolean",
            "title": "Privileged Access",
            "default": false
          },
          "configuration_item_id": {
            "title": "Configuration Item Id",
            "type": "string",
            "nullable": true
          },
          "location_id": {
            "title": "Location Id",
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "ticket_id",
          "summary",
          "description"
        ],
        "title": "LocalTicket"
      },
      "Start": {
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "local",
              "backend"
            ],
            "title": "Mode",
            "default": "local"
          },
          "ticket_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,100}$",
            "title": "Ticket Id"
          },
          "ticket": {
            "$ref": "#/components/schemas/LocalTicket",
            "nullable": true
          },
          "use_llm": {
            "type": "boolean",
            "title": "Use Llm",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "ticket_id"
        ],
        "title": "Start"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "APIKeyHeader": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key"
      }
    }
  }
}
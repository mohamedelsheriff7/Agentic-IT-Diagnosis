# Optional OpenAI-compatible Chat Completions provider. Do not commit real secrets.
DIAGNOSTIC_LLM_BASE_URL=https://your-provider.example/v1
DIAGNOSTIC_LLM_API_KEY=replace-me
DIAGNOSTIC_LLM_MODEL=replace-with-model-name

# Workstream C diagnostic backend integration
DIAGNOSTIC_BACKEND_BASE_URL=http://127.0.0.1:8000
DIAGNOSTIC_BACKEND_API_KEY=replace-with-your-service-api-key

# Agent service key is separate from the Workstream C backend key.
DIAGNOSTIC_SERVICE_API_KEY=generate-a-random-agent-service-key
DIAGNOSTIC_PUBLIC_URL=http://127.0.0.1:8080
DIAGNOSTIC_ARTICLES_FILE=adk-project/knowledge/reviewed/diagnostic_articles.json
